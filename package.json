{
  "name": "apex-table-react",
  "version": "0.1.0-rc.0",
  "description": "面向 TanStack Table v9 原生实例的 React 业务表格界面",
  "type": "module",
  "main": "./dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/local-column-preferences": {
      "types": "./dist/adapters/local-column-preferences.d.ts",
      "import": "./dist/adapters/local-column-preferences.js"
    },
    "./styles/structure.css": "./dist/styles/structure.css",
    "./styles/theme.css": "./dist/styles/theme.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "dumi dev",
    "build": "father build && node scripts/finalize-build.mjs",
    "build:watch": "father dev",
    "docs:build": "pnpm build && node scripts/structure-demo-build.mjs && dumi build",
    "docs:preview": "dumi preview",
    "prepare": "husky install && dumi setup",
    "doctor": "father doctor",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:es && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.{css,less}\"",
    "lint:es": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "prepublishOnly": "father doctor && npm run build"
  },
  "authors": [
    "im.ywh@qq.com"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@tanstack/store": "0.11.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@umijs/lint": "^4.0.0",
    "dumi": "^2.4.38-beta.1",
    "esbuild": "0.25.12",
    "eslint": "^8.23.0",
    "father": "^4.1.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.0.0",
    "prettier-plugin-packagejson": "^2.2.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stylelint": "^14.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "3.14.12"
  }
}
