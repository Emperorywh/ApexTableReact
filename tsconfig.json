{
  "compilerOptions": {
    "strict": true,
    /*
     * 面向现代 ESM 浏览器，保留原生迭代器与异步语义。
     * 显式目标同时用于独立类型消费，不依赖文档临时配置。
     */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    /*
     * 使用现代 JSX 转换，满足 React 19 的编译要求。
     * 该运行时同样支持 React 18，保留组件库的双版本消费能力。
     */
    "jsx": "react-jsx",
    "baseUrl": "./",
    "paths": {
      "@@/*": [".dumi/tmp/*"],
      "ApexTableReact": ["src"],
      "ApexTableReact/*": ["src/*", "*"]
    }
  },
  /*
   * 类型检查覆盖组件源码、构建配置与文档示例。
   * 性能测试目录已清理，示例数据由文档目录独立维护。
   */
  "include": [".dumirc.ts", ".fatherrc.ts", "src/**/*", "docs/demos/**/*"]
}
